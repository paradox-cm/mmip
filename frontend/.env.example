NEXT_PUBLIC_SANITY_PROJECT_ID="t4dq0r7i" # Public Sanity project; defaults to the studio project if unset
NEXT_PUBLIC_SANITY_DATASET="production" # Public dataset; defaults to production if unset
NEXT_PUBLIC_SANITY_API_VERSION="2024-10-28" # Optional - The API version provided to the Sanity Client
NEXT_PUBLIC_SANITY_STUDIO_URL="" #Optional, defaults to http://localhost:3333
# Canonical public origin. Set to https://www.resilientrelatives.org in Vercel Production.
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
SANITY_API_READ_TOKEN="<paste your token here>" # Optional for published builds; required for draft mode and Presentation

# Algolia public search configuration. The search key must only have the `search` ACL.
NEXT_PUBLIC_ALGOLIA_APP_ID="<paste your Algolia application ID here>"
NEXT_PUBLIC_ALGOLIA_SEARCH_API_KEY="<paste your restricted search-only key here>"

# Server-only search indexing configuration. Never prefix these with NEXT_PUBLIC_.
ALGOLIA_WRITE_API_KEY="<paste your restricted Algolia write key here>"
SANITY_WEBHOOK_SECRET="<paste a strong random secret here>"

# Admin console sign-in at /admin/login. Server-only. One username, one password.
# Local `next dev`: if both are unset, /admin stays open. Production/`next start`: unset fails closed.
# Do not reuse SANITY_WEBHOOK_SECRET. Generate a password with: openssl rand -hex 16
ADMIN_BASIC_USER="mmip-admin"
ADMIN_BASIC_PASSWORD="<paste a strong random password here>"
